# ResearchHub AI - Production Environment Variables Template

# 1. Database Configurations
# Replace with your production PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# 2. Security & Session Secrets
# Change this key to a highly secure 32-character hex key in production
# Run: openssl rand -hex 32
JWT_SECRET=super_secret_production_key_random_hex_hash

# 3. LLM API Configurations
# Supply your Groq Developer API Key. If empty or left as placeholder,
# the system operates in simulated offline pipeline mode.
GROQ_API_KEY=gsk_your_groq_developer_api_key_goes_here
